{
  "name": "@device-management-toolkit/sample-web-ui",
  "version": "4.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "enterprise": "ng serve --configuration=enterprise",
    "build": "ng build",
    "build-enterprise": "ng build --configuration=enterprise",
    "test": "ng test",
    "test-ci": "ng test --no-watch --no-progress",
    "lint": "ng lint",
    "prettify": "npx prettier --write '**/*.{ts,js,yaml,css,scss,json,html}'",
    "ci-prettify": "npx prettier --check '**/*.{ts,js,yaml,css,scss,json,html}'",
    "e2e": "ng e2e",
    "cypress-install": "cypress install",
    "cypress": "cypress open",
    "cy-runner": "cypress run",
    "cy-runner:redfish": "cypress run --config-file cypress.redfish.config.ts",
    "cy-runner:all": "cypress run --config-file cypress.config.ts && cypress run --config-file cypress.redfish.config.ts",
    "cy-open:redfish": "cypress open --config-file cypress.redfish.config.ts",
    "cy-open:all": "cypress open --config-file cypress.config.ts",
    "lint:cypress": "eslint ./cypress"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~22.2.2",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/material": "~22.2.2",
    "@angular/platform-browser": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@device-management-toolkit/ui-toolkit-angular": "^12.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@xterm/xterm": "^6.0.0",
    "angular-oauth2-oidc": "^20.0.2",
    "angular-oauth2-oidc-jwks": "^20.0.0",
    "date-fns": "^4.4.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.56.0",
    "ngx-monaco-editor-v2": "^22.0.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "@angular/build": {
      "vite": "~8.3.3"
    },
    "diff": "^8.0.4",
    "dompurify": "^3.4.17",
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.4",
    "@angular-eslint/builder": "~22.6.0",
    "@angular-eslint/schematics": "~22.6.0",
    "@angular-eslint/template-parser": "~22.6.0",
    "@angular/build": "~22.2.3",
    "@angular/cli": "~22.2.4",
    "@angular/compiler-cli": "~22.2.3",
    "@angular/localize": "~22.2.3",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-license-header": "^0.9.0",
    "happy-dom": "^21.0.4",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.2",
    "prettier-config-standard": "^7.0.0",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "ts-node": "~10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
