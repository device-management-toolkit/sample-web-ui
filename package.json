{
  "name": "@device-management-toolkit/sample-web-ui",
  "version": "3.66.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "enterprise": "ng serve --configuration=enterprise",
    "build": "ng build",
    "build-enterprise": "ng build --configuration=enterprise",
    "test": "ng test",
    "test-ci": "ng test --no-watch --no-progress",
    "lint": "ng lint",
    "prettify": "npx prettier --write '**/*.{ts,js,yaml,css,scss,json,html}'",
    "ci-prettify": "npx prettier --check '**/*.{ts,js,yaml,css,scss,json,html}'",
    "e2e": "ng e2e",
    "cypress-install": "cypress install",
    "cypress": "cypress open",
    "cy-runner": "cypress run",
    "cy-runner:redfish": "cypress run --config-file cypress.redfish.config.ts",
    "cy-runner:all": "cypress run --config-file cypress.config.ts && cypress run --config-file cypress.redfish.config.ts",
    "cy-open:redfish": "cypress open --config-file cypress.redfish.config.ts",
    "cy-open:all": "cypress open --config-file cypress.config.ts",
    "lint:cypress": "eslint ./cypress"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.22",
    "@angular/cdk": "~21.2.3",
    "@angular/common": "~21.2.22",
    "@angular/compiler": "~21.2.22",
    "@angular/core": "~21.2.22",
    "@angular/forms": "~21.2.22",
    "@angular/material": "~21.2.3",
    "@angular/platform-browser": "~21.2.22",
    "@angular/router": "~21.2.22",
    "@device-management-toolkit/ui-toolkit-angular": "^11.1.8",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@xterm/xterm": "^6.0.0",
    "angular-oauth2-oidc": "^20.0.2",
    "angular-oauth2-oidc-jwks": "^20.0.0",
    "date-fns": "^4.4.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.55.1",
    "ngx-monaco-editor-v2": "^21.1.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "dompurify": "^3.4.13",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.6",
    "less": "^4.9.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.22",
    "@angular-eslint/builder": "~21.3.0",
    "@angular-eslint/schematics": "~21.4.0",
    "@angular-eslint/template-parser": "~21.4.0",
    "@angular/build": "~21.2.22",
    "@angular/cli": "~21.2.22",
    "@angular/compiler-cli": "~21.2.22",
    "@angular/localize": "~21.2.22",
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "21.4.0",
    "cypress": "^15.21.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-license-header": "^0.9.0",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "playwright": "^1.62.1",
    "prettier-config-standard": "^7.0.0",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "ts-node": "~10.9.2",
    "typescript": "^5.9.2",
